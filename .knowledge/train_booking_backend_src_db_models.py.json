{"is_source_file": true, "format": "Python", "description": "This file defines SQLAlchemy ORM models for a railway ticket booking system, including entities such as User, Station, Train, Schedule, Coach, Seat, SeatInventory, Booking, BookingItem, Payment, Notification, and AuditLog. It establishes the database schema, relationships, and constraints for managing train schedules, bookings, payments, notifications, and user data.", "external_files": ["src/db/session.py"], "external_methods": [], "published": ["PaymentStatus", "BookingStatus", "NotificationType", "User", "Station", "Train", "TrainRoute", "Schedule", "Coach", "Seat", "SeatInventory", "Booking", "BookingItem", "Payment", "Notification", "AuditLog"], "classes": [{"name": "PaymentStatus", "description": "Enumeration of possible payment statuses like created, pending, succeeded, failed, and cancelled."}, {"name": "BookingStatus", "description": "Enumeration of booking statuses such as created, locked, confirmed, and cancelled."}, {"name": "NotificationType", "description": "Enumeration of notification types including info, booking, payment, and system."}, {"name": "User", "description": "Represents a user in the system with attributes like email, full name, hashed password, activity status, superuser status, and relationships to bookings and notifications."}, {"name": "Station", "description": "Represents a train station with code, name, city, and relationships to outgoing and incoming routes."}, {"name": "Train", "description": "Represents a train with a unique number and name, related to routes and coaches."}, {"name": "TrainRoute", "description": "Defines a route for a specific train between source and destination stations, with schedule relationships."}, {"name": "Schedule", "description": "Represents a scheduled trip on a train route with travel date, departure and arrival times, and seat inventory."}, {"name": "Coach", "description": "Represents a train coach with type, number, associated train, and seats."}, {"name": "Seat", "description": "Represents a seat within a coach with seat number and type."}, {"name": "SeatInventory", "description": "Tracks seat availability for a specific schedule, including lock and booking status."}, {"name": "Booking", "description": "Represents a booking made by a user for a specific schedule, including total amount, status, and related items."}, {"name": "BookingItem", "description": "Details individual seats booked within a booking, including price."}, {"name": "Payment", "description": "Represents a payment for a booking, including amount, status, provider reference, and timestamps."}, {"name": "Notification", "description": "Stores notifications sent to users with type, title, message, read status, and timestamp."}, {"name": "AuditLog", "description": "Records audit trail for user actions with action details and timestamp."}], "methods": [], "calls": [], "search-terms": ["SQLAlchemy models", "train schedules", "booking system", "seat inventory", "train routes", "user accounts", "notifications", "payment status", "train station schema"], "state": 2, "file_id": 8, "knowledge_revision": 63, "git_revision": "", "revision_history": [{"17": ""}, {"63": ""}], "ctags": [{"_type": "tag", "name": "AuditLog", "path": "/home/kavia/workspace/code-generation/railway-ticket-booking-system-221364-221374/train_booking_backend/src/db/models.py", "pattern": "/^class AuditLog(Base):$/", "language": "Python", "kind": "class"}, {"_type": "tag", "name": "Booking", "path": "/home/kavia/workspace/code-generation/railway-ticket-booking-system-221364-221374/train_booking_backend/src/db/models.py", "pattern": "/^class Booking(Base):$/", "language": "Python", "kind": "class"}, {"_type": "tag", "name": "BookingItem", "path": "/home/kavia/workspace/code-generation/railway-ticket-booking-system-221364-221374/train_booking_backend/src/db/models.py", "pattern": "/^class BookingItem(Base):$/", "language": "Python", "kind": "class"}, {"_type": "tag", "name": "Bo